+++ b/tests/run_junit.py
@@ -0,0 +1,28 @@
+"""Runs the unit tests and writes a JUnit report to argv[1]."""
+
+import sys
+import unittest
+import xml.etree.ElementTree as ET
+
+sys.path.insert(0, ".")
+suite = unittest.defaultTestLoader.discover("tests", top_level_dir=".")
+root = ET.Element("testsuite")
+
+
+def cases(s):
+    for t in s:
+        yield from cases(t) if isinstance(t, unittest.TestSuite) else [t]
+
+
+for case in cases(suite):
+    result = unittest.TestResult()
+    case.run(result)
+    el = ET.SubElement(
+        root,
+        "testcase",
+        classname=f"{type(case).__module__}.{type(case).__name__}",
+        name=case._testMethodName,
+    )
+    for _, trace in result.failures + result.errors:
+        ET.SubElement(el, "failure", message="failed").text = trace
+ET.ElementTree(root).write(sys.argv[1])
